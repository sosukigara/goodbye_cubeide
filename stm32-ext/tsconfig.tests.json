{
  // Typecheck gate for tests. Extends the base config so tests are held to
  // the same strictness as src; differences are runtime truth, not leniency:
  //  - rootDir/noEmit: tests live outside src, and this project never emits
  //    (base rootDir/outDir semantics for `compile` are untouched).
  //  - module/moduleResolution ESM: tests execute under vitest (vite ESM
  //    transform), never as Node16 CJS, so import.meta is legal here.
  //  - types: exactly the @types set the base project auto-includes.
  // ponytail: include-only gate. All test files under tests/ are
  // type-checked (2026-10-01: the last drift cleared, exclusions removed).
  // Never re-add per-file excludes to hide drift — fix the file instead;
  // do NOT relax strictness to absorb it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vscode"]
  },
  "include": ["src", "tests"],
  "exclude": [
    "node_modules",
    "out"
  ]
}
