# Build output — regenerate with `npm run compile`
out/
build-ext/
*.o
*.elf
*.map

# Dependencies
node_modules/

# Python bytecode. These were tracked, so every pytest run rewrote them and
# `git status` could never be clean — which defeats the one check that proves
# a fresh clone reproduces.
__pycache__/
*.pyc

# Session/agent scratch: logs, snapshots, transcripts
.omo/
.agents/
*.tgz

# Local live-session artifacts written next to the ELF
live.csv
live-resolution.json
live-session.log
stm32-graph.csv

# Packaged extension output
*.vsix

# Editor / OS
.DS_Store
*.swp
